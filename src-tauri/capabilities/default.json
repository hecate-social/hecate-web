{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default capabilities for hecate-web",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:event:default",
		"core:event:allow-listen",
		"core:event:allow-emit",
		"core:window:default",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-start-dragging",
		"shell:allow-open",
		"shell:allow-stdin-write",
		"shell:allow-kill",
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{ "name": "ssh", "cmd": "ssh", "args": true },
				{ "name": "sshpass", "cmd": "sshpass", "args": true },
				{ "name": "bash", "cmd": "bash", "args": true }
			]
		},
		{
			"identifier": "shell:allow-spawn",
			"allow": [
				{ "name": "ssh", "cmd": "ssh", "args": true },
				{ "name": "sshpass", "cmd": "sshpass", "args": true },
				{ "name": "bash", "cmd": "bash", "args": true }
			]
		},
		"updater:default",
		"process:allow-restart",
		"fs:default",
		"fs:read-all",
		"fs:write-all",
		"dialog:default",
		"dialog:allow-open",
		"dialog:allow-save",
		{
			"identifier": "fs:scope",
			"allow": [
				{ "path": "$HOME/.hecate" },
				{ "path": "$HOME/.hecate/**" },
				{ "path": "$HOME/.hecate-dev" },
				{ "path": "$HOME/.hecate-dev/**" }
			]
		}
	]
}
