{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default capabilities for hecate-web",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:event:default",
		"core:event:allow-listen",
		"core:event:allow-emit",
		"core:window:default",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-start-dragging",
		"shell:allow-open",
		"updater:default",
		"process:allow-restart",
		"fs:default",
		"fs:allow-read",
		"fs:allow-write",
		"fs:allow-exists",
		"fs:allow-mkdir",
		"fs:allow-remove",
		"fs:allow-rename",
		"fs:allow-stat",
		"fs:allow-read-dir",
		"fs:allow-watch",
		"fs:allow-unwatch",
		"dialog:default",
		"dialog:allow-open",
		"dialog:allow-save",
		{
			"identifier": "fs:scope",
			"allow": [
				{ "path": "$HOME/.hecate/**" },
				{ "path": "$HOME/.hecate-dev/**" }
			]
		}
	]
}
